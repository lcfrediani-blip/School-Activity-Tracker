{
  "expo": {
    "name": "Fuori Classe",
    "slug": "fuoriclasse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fuoriclasse",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#f8f6f1",
      "image": "./assets/images/icon.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fuoriclasse.app"
    },
    "android": {
      "package": "com.fuoriclasse.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}